generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  name             String?
  weeklyCheckIns   WeeklyCheckIn[]
  tasks            Task[]
  blockers         Blocker[]
  notifications    Notification[]
  projectSettings  ProjectSettings?
  projectUpdates ProjectUpdate[]
  comments Comment[]
}

model WeeklyCheckIn {
  id           Int      @id @default(autoincrement())
  weekNumber   Int
  year         Int
  qAccomplished String?
  qWorkingOn    String?
  qBlockers     String?
  qWorking      String?
  qNotWorking   String?
  comments     String?
  submittedAt  DateTime @default(now())
  isLocked     Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  @@unique([userId, weekNumber, year])
}

model Blocker {
  id          Int          @id @default(autoincrement())
  creator     User         @relation(fields: [creatorId], references: [id])
  creatorId   Int
  title       String
  description String?
  status      String @default("OPEN") // replaced enum for SQLite
  resolvedAt  DateTime?
  reopenedAt  DateTime?
}




model Task {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  assignee    User?          @relation(fields: [assigneeId], references: [id])
  assigneeId  Int?
  priority    String @default("MEDIUM") // replaced enum for SQLite
  status      String @default("TODO") // replaced enum for SQLite
  dueDate     DateTime
  parent      Task?          @relation("Subtasks", fields: [parentId], references: [id])
  parentId    Int?
  subtasks    Task[]         @relation("Subtasks")
  dependencies TaskDependency[] @relation("TaskDependenciesFrom")
  dependents   TaskDependency[] @relation("TaskDependenciesTo")
  attachments TaskAttachment[]
}







model TaskDependency {
  task            Task @relation("TaskDependenciesFrom", fields: [taskId], references: [id])
  taskId          Int
  dependsOn       Task @relation("TaskDependenciesTo", fields: [dependsOnTaskId], references: [id])
  dependsOnTaskId Int
  @@id([taskId, dependsOnTaskId])
}

model TaskAttachment {
  id Int @id @default(autoincrement())
  task Task @relation(fields: [taskId], references: [id])
  taskId Int
  fileName String
  originalName String
  fileUrl String
  fileType String
  fileSize Int
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model AiWeeklySummary {
  id         Int      @id @default(autoincrement())
  weekNumber Int
  year       Int
  content    String
  createdAt  DateTime @default(now())
}

model ProjectSettings {
  id                      Int     @id @default(autoincrement())
  weeklyDeadlineDay       Int @default(5)
  weeklyDeadlineTime      String @default("17:00")
  retentionDays           Int @default(90)
  notifyWeeklyReminder    Boolean @default(true)
  notifyBlockers          Boolean @default(true)
  notifyMentions          Boolean @default(true)
  user                    User    @relation(fields: [userId], references: [id])
  userId                  Int @unique
}
model ProjectUpdate {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int
  content String
  createdAt DateTime @default(now())
  comments Comment[]
}

model Comment {
  id Int @id @default(autoincrement())
  update ProjectUpdate @relation(fields: [updateId], references: [id])
  updateId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  content String
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  parentId Int?
  replies Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
}
